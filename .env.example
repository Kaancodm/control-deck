DECK_DATABASE_URL=
DECK_TEST_DATABASE_URL=
# Use a distinct token for each enabled worker lane; leave unused lanes empty.
DECK_WORKER_TOKEN_OLLAMA=
DECK_WORKER_TOKEN_CLAUDE=
DECK_WORKER_TOKEN_CODEX=
DECK_OWNER_TOKEN=
DECK_LEASE_TTL_SECONDS=900
DECK_HEARTBEAT_EXTEND_SECONDS=300
