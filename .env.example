DECK_INBOX_DIR=inbox
# Required for cloud tasks: a UTF-8 literal blocklist outside the repository.
DECK_BLOCKLIST_PATH=
DECK_BIND_HOST=
DECK_SECRET_KEY=
OLLAMA_URL=
KB_DB_URL=
