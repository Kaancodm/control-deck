DECK_DATABASE_URL=
DECK_TEST_DATABASE_URL=
# Use a distinct token for each enabled worker lane; leave unused lanes empty.
DECK_WORKER_TOKEN_OLLAMA=
DECK_WORKER_TOKEN_CLAUDE=
DECK_WORKER_TOKEN_CODEX=
DECK_OWNER_TOKEN=
DECK_LEASE_TTL_SECONDS=900
DECK_HEARTBEAT_EXTEND_SECONDS=300
# Defaults to inbox when unset. Attachments must be relative to this directory.
DECK_INBOX_DIR=inbox
# Required for cloud tasks: a UTF-8 literal blocklist outside the repository.
DECK_BLOCKLIST_PATH=
DECK_BIND_HOST=
DECK_SECRET_KEY=
OLLAMA_URL=
KB_DB_URL=
# Knowledge access is disabled by default; only the isolated test profile exists.
DECK_KB_PROFILE=disabled
DECK_KB_TEST_DATABASE_URL=
# Explicit comma-separated host allowlist; wildcards and ports are rejected.
DECK_ALLOWED_HOSTS=
DECK_BIND_PORT=8000
# Optional canonical HTTPS origin for an independently configured TLS proxy.
DECK_PUBLIC_ORIGIN=
# Optional private configuration file to verify (owned, regular, single link, mode 600).
DECK_ENV_FILE=
