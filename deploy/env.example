# External runtime configuration; keep the actual file private and outside the repository.
DECK_DATABASE_URL=
# Runtime knowledge database; used by maintenance and, only with DECK_KB_PROFILE=runtime,
# by the knowledge store. Must differ from DECK_DATABASE_URL.
DECK_KB_DATABASE_URL=
# Knowledge profile: empty or disabled (default), simulation (_test database only), or
# runtime (DECK_KB_DATABASE_URL, requires the ollama provider). Owner GO before runtime.
DECK_KB_PROFILE=
# Embedding provider: empty means fake (simulation only); runtime requires ollama.
DECK_KB_EMBEDDING_PROVIDER=
# Required with ollama: local model name:tag and the schema width (see docs/WISSENS_DB.md).
DECK_KB_EMBEDDING_MODEL=
DECK_KB_EMBEDDING_DIMENSION=
# Optional: total budget in seconds (1 to 85, default 60) and keep_alive (default server).
DECK_KB_EMBEDDING_TIMEOUT_S=
DECK_KB_EMBEDDING_KEEP_ALIVE=
# Loopback Ollama URL for API-process embeddings (http://127.0.0.1:<port>); the runner
# keeps its own value in the separate runner environment file.
DECK_OLLAMA_URL=
DECK_BIND_HOST=
DECK_BIND_PORT=8000
DECK_ALLOWED_HOSTS=
DECK_ENV_FILE=
# Explicit absolute search directories for uv, restic and PostgreSQL client binaries.
DECK_OPERATIONS_PATH=/usr/local/bin:/usr/bin:/bin
DECK_RUNS_DIR=runs
DECK_INBOX_DIR=inbox
DECK_BACKUP_DIR=backups
# Backups with --target test never share the production backup directory.
DECK_TEST_BACKUP_DIR=backups_test
# Restore rehearsals require distinct, explicitly isolated test databases.
DECK_TEST_DATABASE_URL=
DECK_KB_TEST_DATABASE_URL=
DECK_RESTORE_TEST_DATABASE_URL=
DECK_KB_RESTORE_TEST_DATABASE_URL=
# Optional restic configuration; no credential contents belong here.
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=
