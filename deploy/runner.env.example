# Runner-only configuration; keep the actual file private and outside the repository.
# Never copy the owner token, secret key, or knowledge-base settings into this file.
DECK_DATABASE_URL=
DECK_RUNS_DIR=runs
DECK_INBOX_DIR=inbox
DECK_BLOCKLIST_PATH=
DECK_ROUTER_FILE=
# Only exact 1 or true enables the Ollama live lane. Configure only in this file.
DECK_LIVE_ENABLED=0
# Explicit HTTP loopback literal and port; no path, userinfo, query, or fragment.
DECK_OLLAMA_URL=
