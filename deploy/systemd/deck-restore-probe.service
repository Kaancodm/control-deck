[Unit]
Description=Control Deck restore dry-run reminder (no restore)

[Service]
Type=oneshot
WorkingDirectory=@REPOSITORY@
EnvironmentFile=@ENVIRONMENT@
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=@PYTHON@ -m app.operations.main restore-probe
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
TimeoutStartSec=600
