[Unit]
Description=Control Deck completed artifact retention

[Service]
Type=oneshot
WorkingDirectory=@REPOSITORY@
EnvironmentFile=@ENVIRONMENT@
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=@PYTHON@ -m app.operations.main retention --apply --target runtime
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@REPOSITORY@/runs
TimeoutStartSec=600
