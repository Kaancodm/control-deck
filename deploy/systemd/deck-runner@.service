[Unit]
Description=Control Deck lane %i
After=network.target

[Service]
Type=simple
WorkingDirectory=@REPOSITORY@
# Runner-only settings; never the API file holding the owner token and secret key.
EnvironmentFile=@RUNNER_ENVIRONMENT@
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=@PYTHON@ -m app.workers.daemon --worker %i
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@REPOSITORY@/runs
# SIGTERM reaches only the supervisor, which stops its attempt group itself.
KillMode=mixed
TimeoutStopSec=15

[Install]
WantedBy=default.target
