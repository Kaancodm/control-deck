{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-deck.local/schemas/result.v1.json",
  "title": "Control Deck Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "attempt",
    "worker",
    "status",
    "output",
    "checks",
    "usage",
    "timing",
    "error",
    "redaction",
    "payload_hash",
    "log_ref"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "result.v1"
    },
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "worker": {
      "type": "string",
      "enum": ["ollama", "claude", "codex"]
    },
    "status": {
      "type": "string",
      "enum": ["succeeded", "failed", "cancelled", "blocked"]
    },
    "output": {
      "$ref": "#/$defs/output"
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "usage": {
      "$ref": "#/$defs/usage"
    },
    "timing": {
      "$ref": "#/$defs/timing"
    },
    "error": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/error_detail" }
      ]
    },
    "redaction": {
      "$ref": "#/$defs/redaction"
    },
    "payload_hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "log_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "failed" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "error": { "$ref": "#/$defs/error_detail" }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "succeeded" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "error": { "type": "null" }
        }
      }
    }
  ],
  "$defs": {
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "files"],
      "properties": {
        "text": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/output_file"
          }
        }
      }
    },
    "output_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sha256"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "passed", "detail"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "passed": {
          "type": "boolean"
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_seconds"],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "wall_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "finished_at"],
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "error_detail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "worker_unavailable",
            "auth_required",
            "rate_limited",
            "timeout",
            "policy_blocked",
            "acceptance_failed",
            "internal"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applied", "placeholders"],
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "placeholders": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
